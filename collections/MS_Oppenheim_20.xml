               <msContents>
                  <summary>Midrash Tanḥuma</summary>
                  <msItem>
                     <title type="desc" xml:lang="he" key="work_355">מדרש תנחומא</title>
                     <title type="desc" xml:lang="he-Latn-x-lc" key="work_355">Midrash
                        Tanḥuma</title>
                     <note><p>Final leaves missing; ends at the beginning of the parasha <hi
                              rend="italic">vezot haberakha</hi>
                           <foreign xml:lang="he">וזאת הברכה</foreign>. </p>
                        <p>Used by Salomon Buber as the base text for his edition of the <hi
                              rend="italic">Midrash Tanḥuma</hi> (Vilna, 1885); Buber did not note
                           or make use of all the marginal additions.</p></note>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc>
                        <support>paper and parchment; <note>several of the parchment leaves
                                 (<locus>ff. 17, 18, 29, 32, 35-39</locus>) belonging to the
                              original manuscript have been damaged or lost; these have since been
                              replaced by paper where the missing text has been supplied by later
                              hands in both square and semi-cursive scripts.</note></support>
                        <extent>ff. 223 <dimensions type="leaf" unit="mm">
                              <height>300</height>
                              <width>240</width>
                           </dimensions></extent>
                     </supportDesc>
                     <layoutDesc>
                        <p>in two columns.</p>
                     </layoutDesc>
                  </objectDesc>
                  <handDesc>
                     <summary>Ashkenazic square script</summary>
                     <handNote/>
                  </handDesc>
                  <bindingDesc>
                     <p>Vellum over thick wooden boards with bevelled edges, clasps now missing.</p>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate>[c. 1300]</origDate>
                     <origPlace>[Ashkenaz]</origPlace>
                  </origin>
                  <provenance>Ownership inscription by Yuda Leib <foreign xml:lang="he">יודא
                        ליב</foreign> on <locus>f. 223v</locus>.</provenance>
                  <acquisition>It belonged to <persName ref="https://viaf.org/viaf/7753200"
                        key="person_7753200">David ben Abraham Oppenheim</persName>'s <date
                        calendar="#Gregorian">(1664-1736)</date> library, which was purchased by the
                     Bodleian Library in <date calendar="#Gregorian">1829</date>.</acquisition>
               </history>
