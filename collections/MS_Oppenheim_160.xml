               <msContents>
                  <summary>Eleazar of Worms's commentary on the Siddur</summary>
                  <msItem>
                     <title type="desc" xml:lang="he" key="work_3375">פרוש התפלות לאלעזר בן יהודה
                        מגרמיזא</title>
                     <title type="desc" xml:lang="he-Latn-x-lc" key="work_3375">Perush ha-tefillot
                        le-Elʿazar ben Yehudah mi-Germiza</title>
                     <author key="person_301948260">
                        <persName>Eleazar ben Judah, of Worms, approximately 1176-1238</persName>
                        <persName xml:lang="he">אלעזר בן יהודה מגרמיזה</persName>
                     </author>
                     <note>Parts of the commentary on the Hallel were edited by <persName>Moshe
                           Hershler</persName> in <hi rend="italic">Sinai 72</hi> (1973):
                        228-47.</note>
                     <note>The commentary on the Haggadah was used (alongside several other
                        manuscripts) by <persName>Moshe Hershler</persName> in his edition
                        (Jerusalem, 1984).</note>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc>
                        <support>parchment</support>
                        <extent n="297">ff. 297<dimensions type="leaf" unit="mm">
                              <height>310</height>
                              <width>230</width>
                           </dimensions></extent>
                        <condition>Water damage on some folios (especially <locus>ff.
                              205-230</locus>), which has made some of the text illegible.
                              <locus>Ff. 1 and 291-297</locus> are injured.</condition>
                     </supportDesc>
                  </objectDesc>
                  <handDesc>
                     <summary>Ashkenazic semi-cursive scripts</summary>
                     <handNote>Copied by two scribes: <locus>ff. 1-175, 264-297</locus> by a scribe
                        who pointed out the name Yehudah <foreign xml:lang="he">יהודה</foreign> (see
                        for example <locus>ff. 34v, 82r, 293v</locus>); <locus>ff. 176-263</locus>
                        by a scribe who pointed out the name Elʿazar <foreign xml:lang="he"
                           >אלעזר</foreign> (<locus>f. 239v</locus>).</handNote>
                  </handDesc>
                  <additions>A part of the <hi rend="italic">Tur Oraḥ Ḥayyim</hi> (up to <foreign
                        xml:lang="he">ארבעה צריכים להודות</foreign>) has been copied by a later hand
                     on the margins on <locus>ff. 1r-69r</locus>.</additions>
                  <bindingDesc>
                     <p>Vellum over paper boards. The spine now bears the title (handwritten in
                        ink), the current shelfmark (handpainted in black) and the Neubauer
                        catalogue number (printed on a paper label).</p>
                     <condition>Two pairs of leather straps were originally attached to the upper
                        and lower boards; these have been cut off.</condition>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate>[early 13th cent.]</origDate>
                     <origPlace>[Ashkenaz]</origPlace>
                  </origin>
                  <provenance> </provenance>
                  <acquisition>It belonged to the library of <persName key="person_7753200">David
                        Oppenheim</persName> (<date calendar="Gregorian">1664-1736</date>), which
                     was purchased by the Bodleian Library in <date calendar="Gregorian"
                     >1829</date>.</acquisition>
               </history>
