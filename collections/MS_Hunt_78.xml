               <msContents>
                  <msItem n="1">
                     <title xml:lang="he-Latn-x-lc" key="work_50">Arbaʾah Ṭurim (Even ha-ʾEzer,
                        Ḥoshen Mishpaṭ)‏</title>
                     <title xml:lang="he" key="work_50">ארבעה טורים (חשן משפט, אבן העזר)</title>
                     <author key="person_301582237">
                        <persName>Jacob ben Asher, approximately 1269-approximately 1340</persName>
                        <persName xml:lang="he">יעקב בן אשר</persName></author>
                     <note>Contains two out of the four divisions of the <hi rend="italic">Arbaʾah
                           Ṭurim</hi>.</note>
                     <note>Both divisions are incomplete. The <hi rend="italic">Ḥoshen Mishpaṭ</hi>
                        ends on <locus>f. 282v</locus>, coinciding with the end of <hi rend="italic"
                           >Siman 382</hi> (<hi rend="italic">Siman 380</hi> of the printed
                        edition); the <hi rend="italic">Even ha-ʾEzer</hi> begins on the facing
                        folio (<locus>f. 283r</locus>), towards the end of <hi rend="italic">Siman
                           37</hi> (<hi rend="italic">Siman 38</hi> of the printed edition).</note>
                     <note>The end of one division and the beginning of the next are signalled by
                        two short Latin notes at the bottom of <locus>ff. 282v and
                        283r</locus>.</note>
                     <note>With annotations and corrections found in between the lines and on the
                        margins.</note>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc material="chart">
                        <support>paper</support>
                        <extent n="354">ff. 354</extent>
                        <condition>The lower margin of <locus>f. 71</locus> has been torn off,
                           resulting in the loss of several lines of text. Similar tears along the
                           outer and lower margins of <locus>ff. 207-8</locus> has not resulted in
                           any loss of text. Some minor worm damage along the lower margins of some
                           folios.</condition>
                     </supportDesc>
                  </objectDesc>
                  <handDesc>
                     <handNote>Sephardic semi-cursive scripts</handNote>
                  </handDesc>
                  <bindingDesc>
                     <p>Smooth golden-brown leather over pasteboards, with blind-tooled decoration
                        along the turn-ins and the outer edges of the boards. The author’s name
                        (‘JACOB B. ASHER’) and the current shelfmark are gold-tooled on the
                        spine.</p>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin><origPlace>[Sepharad;</origPlace><origDate calendar="#Julian"
                        notBefore="1425" notAfter="1475">mid-15th century]</origDate> As indicated
                     by various watermarks, e.g. Briquet no. 3528, dated <date calendar="#Julian"
                        >1429-53</date>.</origin>
                  <acquisition>It belonged to the oriental collection of <persName
                        ref="http://viaf.org/viaf/34684157" key="person_131">Robert
                        Huntington</persName>
                     <date calendar="#Gregorian">(1637-1701)</date>, and was bought in <date
                        calendar="#Gregorian">1693</date> together with 645 other MSS for £752
                     10s.</acquisition>
               </history>
