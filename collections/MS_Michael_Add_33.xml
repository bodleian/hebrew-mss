               <msContents>
                  <msItem>
                     <title type="desc" key="work_3373">Ibn Ezra's Commentary on Prophets and
                        Hagiographa, including the Twelve Minor Prophets, Daniel, Ruth, Song of
                        Songs, and Lamentations</title>
                     <title type="desc" xml:lang="he" key="work_3373">פרוש נביאים וכתובים לראב"ע
                        :כולל תרי עשר, דניאל, רות, שה"ש ואיכה</title>
                     <title type="desc" xml:lang="he-Latn-x-lc">Perush neviʾim ṿe-ketuvim le-Rab"ʿa:
                        khollel trei ʻasar, Daniel, Rut, ShH"Sh ṿe-Eikha</title>
                     <author key="person_90633023">
                        <persName>Ibn Ezra, Abraham ben Meïr, 1089-1164</persName>
                        <persName xml:lang="he">אבן עזרא, אברהם בן מאיר, 1089-1164</persName>
                     </author>
                     <note>A fragment of <persName key="person_100213323">David Ḳimḥi</persName>'s
                           <hi rend="italic">Dictionary</hi> (from <foreign xml:lang="he"
                           >אזרא</foreign> to <foreign xml:lang="he">ספת</foreign>) on <locus>f.
                           111</locus>.</note>
                     <note>Used for variants by <persName>Abe Lipshitz</persName> in his edition
                           (<date calendar="#Gregorian" when="1988">1988</date>) of <persName
                           key="person_90633023">Abraham ibn Ezra</persName>'s Commentary on Hosea,
                        and by <persName>Uriel Simon</persName> in his edition (<date
                           calendar="#Gregorian" when="1989">1989</date>) of the Commentary on the
                        Minor Prophets.</note>
                     <note>On the final folio (<locus>f. 112</locus>), some riddles and a medical
                        prescription in a different hand.</note>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
               </msContents>
