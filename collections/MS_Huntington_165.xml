               <msContents>
                  <summary>The Guide for the Perplexed: in Judeo-Arabic</summary>
                  <msItem>
                     <title xml:lang="he" key="work_67">דלאלה אלחאירין</title>
                     <title xml:lang="he-Latn-x-lc" key="work_67">Dalālat al-ḥā'irīn (Guide for the
                        Perplexed)</title>
                     <author key="person_100185495">
                        <persName>Moses ben Maimon, 1138-1204</persName>
                        <persName xml:lang="he">משה בן מימון, 1138-1204 </persName>
                     </author>
                     <textLang>Judeo-Arabic</textLang>
                     <note>Between <locus>ff. 65 and 66</locus>, a loose paper leaf measuring
                           <dim>165 x 74 mm</dim> has been glued to <locus>f. 66r</locus> near the
                        gutter; it contains three liturgical poems in a modern hand.</note>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc>
                        <support>Oriental laid paper (not Yemenite)</support>
                        <extent>ff. 116 <dimensions type="leaf" unit="mm">
                              <height>206</height>
                              <width>148</width>
                           </dimensions></extent>
                     </supportDesc>
                  </objectDesc>
                  <handDesc>
                     <summary>Yemenite semi-square script</summary>
                     <handNote>Written and collated by <persName>Joseph ben Saadiah ben Shmuel
                           haThemani</persName>
                        <persName xml:lang="he">יוסף בן סעדיה בן שמואל התימני</persName>, finished
                        in the month of Av (no year). </handNote>
                     <handNote>The index at the end is by a later hand.</handNote>
                  </handDesc>
                  <bindingDesc>
                     <p>Dark reddish-brown blind-tooled leather over thin paper boards, with an
                        envelope flap.</p>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate>[15th century]</origDate>
                     <origPlace>[Orient, outside of Yemen (?)]</origPlace>
                  </origin>
                  <provenance> </provenance>
                  <acquisition>It belonged to the oriental collection of <persName
                        ref="http://viaf.org/viaf/34684157" key="person_131">Robert
                        Huntington</persName>
                     <date calendar="#Gregorian">(1637-1701)</date>, and was bought in <date
                        calendar="#Gregorian">1693</date> together with 645 other MSS for £752
                     10s.</acquisition>
               </history>
