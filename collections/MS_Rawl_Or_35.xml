               <msContents>
                  <msItem>
                     <title ref="xjw_zty_43c" xml:lang="he" key="work_3368">ספר האשל</title>
                     <title xml:lang="he-Latn-x-lc" key="work_3368">Sefer ha-ʾEshel</title>
                     <author ref="d1d_pmr_m3c" key="person_7069">
                        <persName>Yitsḥaḳ ben Yehudah</persName>
                        <persName xml:lang="he">יצחק בן יהודה</persName>
                     </author>
                     <textLang mainLang="he">Hebrew</textLang>
                     <note>A grammatical work by Yitsḥaḳ ben Yehudah. According to Parma,
                        Biblioteca Palatina, MS 2650 (De Rossi 1353), <locus>f. 87r</locus>, this
                        work was composed in <date calendar="#Gregorian" when="1240"
                        >1240</date>.</note>
                     <note>The text is defective at the end.</note>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc>
                        <support>The outer and inner bifolia of quires are made of parchment. The
                           remaining bifolia are made of paper.</support>
                        <extent n="104">ff. 104 <dimensions type="leaf" unit="mm">
                              <height>185</height>
                              <width>130</width>
                           </dimensions></extent>
                     </supportDesc>
                  </objectDesc>
                  <handDesc>
                     <handNote>Italian cursive script.</handNote>
                  </handDesc>
                  <bindingDesc>
                     <p>Smooth golden-brown leather over paper boards. The title ‘INSTITT. L. HEBR.
                        R. ISAACI B. JEHUDA’ has been gold-tooled on the spine; at the base of the
                        spine, a black leather label bearing the current shelfmark.</p>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin><origPlace>[Italy</origPlace><origDate calendar="#Gregorian"
                        notBefore="1350" notAfter="1400"> c. 1375 (watermarks similar to Briquet no.
                        3564, dated 1365-75)]</origDate></origin>
                  <provenance>Ownership inscription by <persName ref="osj_pmr_m3c" key="person_7073"
                        >Mordekhai Bonafos Franẓisḳi <foreign xml:lang="he">מרדכי בונפוש
                           פרנציסקי</foreign></persName> on <locus>f. 1r</locus>.</provenance>
                  <acquisition>From the collection of <persName key="person_7079">Thomas
                        Rawlinson</persName> (<date calendar="Gregorian">1681-1725</date>), which
                     was purchased after his death by his younger brother, <persName
                        key="person_7080">Richard Rawlinson</persName> (<date calendar="Gregorian"
                        >1690-1755</date>), in <date calendar="Gregorian">1733/4</date>. These
                     manuscripts, together with all other manuscripts and printed books in
                        <persName>Richard Rawlinson</persName>'s possession, were bequeathed by his
                     will to the Bodleian Library and received by the library in <date
                        calendar="Gregorian">1756</date>.</acquisition>
               </history>
