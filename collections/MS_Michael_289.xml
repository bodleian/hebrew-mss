               <msContents>
                  <summary>A collection of commentaries on the Hebrew Bible</summary>
                  <msItem n="1">
                     <locus>Ff. 1r-62v</locus>
                     <title type="desc" key="work_3340">Abraham ibn Ezra's commentary on the
                        Writings (Ecclesiastes, Job)</title>
                     <title type="desc" xml:lang="he" key="work_3340">פרוש כתובים לראב"ע (קהלת,
                        איוב)</title>
                     <title type="desc" xml:lang="he-Latn-x-lc">Perush Ketuvim le-RAB"ʿ (Ḳohelet,
                        Iyyov)</title>
                     <author key="person_90633023">
                        <persName>Ibn Ezra, Abraham ben Meïr, 1089-1164</persName>
                        <persName xml:lang="he">אבן עזרא, אברהם בן מאיר, 1089-1164</persName>
                     </author>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
                  <msItem n="2">
                     <locus>Ff. 63r-171r</locus>
                     <title type="desc" key="work_3341">Levi ben Gershom's commentary on the
                        Writings</title>
                     <title type="desc" xml:lang="he" key="work_3341">פרוש כתובים לרלב"ג</title>
                     <title type="desc" xml:lang="he-Latn-x-lc">Perush Ketuvim le-RaLBa"G</title>
