                    <msContents>
                        <summary>Siddur for the entire year, Western Ashkenazi rite</summary>
                        <msItem n="1" xml:id="MS_Marshall_Or_133_1_a">
                            <locus>ff. 1r-157v</locus>
                            <title>Siddur for the entire year according to the Western Ashkenazi
                                rite</title>
                            <title xml:lang="he"> סדור מנהג אשכנז המערבי לכל השנה</title>
                            <note>First volume of a three-volume set; second volume: <ref
                                    target="/p/m/78r8h08z4n3337cms4ntz2wayr">MS. Marshall Or.
                                    133(2)</ref>; third volume <ref
                                    target="/p/m/s23pbewjks0z18c765crne4q5g">MS. Marshall Or.
                                    133(3)</ref>.</note>
                            <note>Content: <hi rend="italic">yotserot</hi> for <hi rend="italic"
                                    >Shabbat bereshit</hi>, <hi rend="italic">Shabbat Rosh
                                    ḥodesh</hi>, <hi rend="italic">Shabbat hafsaḳah</hi>, the
                                Sabbaths between Passover and Shavuot, the Shabbat before the Ninth
                                of Av, and <hi rend="italic">Shabbat Naḥamu</hi>. </note>
                            <textLang mainLang="he">Hebrew</textLang>
                        </msItem>
                    </msContents>
