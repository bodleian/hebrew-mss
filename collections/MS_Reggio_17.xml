               <msContents>
                  <summary>Autograph manuscript of Daniel b. Moses David Terni's commentary on the
                     Pentateuch</summary>
                  <msItem>
                     <title xml:lang="he" ref="p4v_zty_43c" key="work_3351">שם עולם</title>
                     <title xml:lang="he-Latn-x-lc" key="work_3351">Shem ʿOlam</title>
                     <author key="person_7060" ref="rpc_pmr_m3c">
                        <persName>Terni, Daniel ben Moses David, active 18th century-19th
                           century</persName>
                        <persName xml:lang="he">דניאל בן משה דוד טירני</persName></author>
                     <textLang mainLang="he">Hebrew</textLang>
                     <note>The first part (<locus>ff. 1r-55v</locus>) of the commentary is on
                        Genesis; the second part (<locus>ff. 56r-107v</locus>) deals with various
                        passages from the rest of the Pentateuch, from Psalms as well as verses from
                        other parts of the Hebrew Bible.</note>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc material="chart">
                        <support>paper</support>
                        <extent n="107">ff. 107 <dimensions type="leaf" unit="mm">
                              <height>204</height>
                              <width>150</width>
                           </dimensions>
                           <note>Some smaller leaves of various sizes, which have been glued into
                              the book.</note>
                           <note><locus>Ff. 2-4</locus> are blank.</note>
                        </extent>
                     </supportDesc>
                  </objectDesc>
                  <handDesc>
                     <summary>Italian cursive script</summary>
                     <handNote>Written by Daniel b. Moses David Terni himself.</handNote>
                  </handDesc>
                  <decoDesc>
                     <p>Painted frames on the title pages of the two parts (<locus>ff. 1r,
                           56r</locus>), as well as painted initial words (<locus>ff. 8r,
                           56v</locus>), in red, blue, brown and gold.</p>
                  </decoDesc>
                  <bindingDesc>
                     <p>Smooth dark brown leather over thin paper boards, with simple blind-tooled
                        decoration on the upper and lower boards, on the edges of the boards and on
                        the turn-ins. On the spine, a paper label bearing the handwritten number
                        ‘17’.</p>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin><origPlace key="place_100">Ancona (Italy)</origPlace>
                     <origDate calendar="#Gregorian" when="1761">1761</origDate></origin>
                  <acquisition>It belonged to <persName key="person_67197037">Isaac Samuel
                        Reggio</persName>'s <date calendar="#Gregorian">(1784-1855)</date> library,
                     which was purchased <hi rend="italic">en bloc</hi> by the Bodleian Library in
                        <date calendar="#Gregorian">1853</date>.</acquisition>
               </history>
