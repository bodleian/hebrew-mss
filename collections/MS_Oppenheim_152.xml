               <msContents>
                  <summary>Moses ben Isaac ben ha-Nessiah's <hi rend="italic">The Onyx
                     Book</hi></summary>
                  <msItem>
                     <title xml:lang="he" key="work_3374">ספר השהם</title>
                     <title xml:lang="he-Latn-x-lc" key="work_3374">Sefer ha-Shoham</title>
                     <author key="person_56385920">
                        <persName>Moses ben Isaac, haNessiah, active 13th century</persName>
                        <persName xml:lang="he">משה בן יצחק בן הנשיאה</persName>
                     </author>
                     <note>A laudatory poem on the author is included at the beginning of the
                        manuscript.</note>
                     <note><locus>F. 1r</locus> contains grammatical terms and their
                           <lang>(Judeo-)French</lang> equivalents. <locus>F. 129r</locus> contains
                        a list of books by an owner.</note>
                     <note>The first part of the manuscript (up to <locus>f. 45r</locus>) was used
                        by <persName>Benjamin Klar</persName> in his edition (Jerusalem,
                        1947).</note>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc>
                        <support>paper</support>
                        <extent n="129">ff. 129 <dimensions type="leaf" unit="mm">
                              <height>265</height>
                              <width>175</width>
                           </dimensions></extent>
                        <condition><p>The parchment leaves tend to have irregular edges along the
                              outer and bottom margins.</p></condition>
                     </supportDesc>
                  </objectDesc>
                  <handDesc>
                     <summary>Ashkenazic semi-cursive scripts</summary>
                     <handNote>Copied by two scribes; the first scribe copied <locus>ff.
                           2r-68v</locus> and the second scribe, who took over at the beginning of a
                        new quire, copied <locus>ff. 69r-128r</locus>. The two scribes employed
                        different pricking and ruling practices.</handNote>
                  </handDesc>
                  <additions><p>On <locus>f. 1r</locus>, a laudatory poem on the author and a list
                        of grammatical terms and their Judeo-French equivalents in a later hand.</p>
                     <p>On <locus>f. 290r</locus>, several notes by later owners, including a list
                        of books and the names of some of the grains, seeds and beans forbidden
                        during Passover, in both Hebrew and Yiddish.</p>
                     <p>Some marginal notes throughout the manuscript.</p></additions>
                  <bindingDesc>
                     <p>Dark brown leather on thick wooden boards, with blind-tooled decoration on
                        both upper and lower boards. Two small paper labels on the spine (on one of
                        these, the letters '<foreign xml:lang="he">קט</foreign>' can be made out).
                        The current shelfmark ('152') has been painted in white on the spine.</p>
                     <condition>The metal bosses originally attached to the upper and lower boards
                        are now missing. The original leather covering the spine and the boards has
                        been severely damaged; the manuscript has since been rebacked with vellum,
                        with fragments of the original leather spine being glued on top.</condition>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate calendar="#Gregorian">[c. 1300]</origDate>
                     <origPlace>[Ashkenaz]</origPlace>
                  </origin>
                  <provenance>At the top of <locus>f. 1r</locus>, an ownership inscription by
                        <persName>Yuda b. Mosheh Ashkenazi <foreign xml:lang="he">יודא בן משה
                           אשכנזי</foreign></persName>.</provenance>
                  <acquisition>It belonged to the library of <persName key="person_7753200">David
                        Oppenheim</persName> (<date calendar="Gregorian">1664-1736</date>), which
                     was purchased by the Bodleian Library in <date calendar="Gregorian"
                     >1829</date>.</acquisition>
               </history>
