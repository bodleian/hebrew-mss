               <msContents>
                  <summary>Halakhic and liturgical compendium</summary>
                  <msItem n="1">
                     <locus>ff. 1r-124v</locus>
                     <title key="work_43">The Small Book of Commandments</title>
                     <title xml:lang="he" key="work_43">ספר מצוות קטן</title>
                     <title xml:lang="he-Latn-x-lc">Sefer Mitsṿot Ḳatan</title>
                     <author key="person_292205904">
                        <persName>Isaac ben Joseph, of Corbeil, active 13th century</persName>
                        <persName xml:lang="he">יצחק בן יוסף מקורביל</persName>
                     </author>
                     <note>With the glosses by <persName key="person_70348690">Perez ben Elijah of
                           Corbeil</persName>, without the introductory letter by the author.</note>
                     <note>The beginning of the index is wanting.</note>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
                  <msItem n="2">
                     <locus>ff. 125r-131r</locus>
                     <title key="work_410">Sefer ha-Yirʾah (The Book of Awe)</title>
                     <title xml:lang="he" key="work_410">ספר היראה</title>
                     <author key="person_25683756">
                        <persName>Jonah ben Abraham Gerondi, approximately 1200-1263</persName>
                        <persName xml:lang="he">יונה בן אברהם גירונדי</persName>
                     </author>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
                  <msItem n="3">
                     <locus>ff. 131r-151r</locus>
                     <title key="work_3382">Sefer Ḥasidim (The Book of the Pious)</title>
                     <title xml:lang="he" key="work_3382">ספר חסידים</title>
                     <author key="person_4155464786402041075">
                        <persName>Judah ben Samuel, approximately 1150-1217</persName>
                        <persName xml:lang="he">יהודה בן שמואל, החסיד, בערך 1150-1217</persName>
                     </author>
                     <note>The title given for this work in the manuscript is <hi rend="italic"
                           >Sefer ha-Ḥasidut <foreign xml:lang="he">ספר
                        החסידות</foreign></hi>.</note>
                     <note>The text has no divisions into sections; it ends with no. 154 of the
                        printed edition.</note>
                     <note>The text contains more French glosses than the printed edition.</note>
                     <textLang mainLang="he">Hebrew</textLang>
                  </msItem>
